rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reservations/{resId} {
      allow create: if request.auth != null && request.resource.data.user == request.auth.token.email;
      allow read: if request.auth != null && (request.auth.token.role == 'admin' || resource.data.user == request.auth.token.email);
      allow update: if request.auth != null && (request.auth.token.role == 'admin' || resource.data.user == request.auth.token.email);
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
