rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if request.auth.uid == userId || request.auth.token.role == 'admin';
      allow update: if request.auth.uid == userId || request.auth.token.role == 'admin';
    }

    match /reservations/{resId} {
      // Users can create their own reservations
      allow create: if request.auth != null && request.resource.data.user == request.auth.token.email;
      
      // Users can read their own reservations, guards can read all, admins can read all
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'guard' || 
        resource.data.user == request.auth.token.email
      );
      
      // Users/Guards can update their reservations, admins can update all
      allow update: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        resource.data.user == request.auth.token.email
      );
      
      // Only admins can delete
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /slots/{slotId} {
      // Everyone can read slots
      allow read: if true;
      
      // Only admins can write slots
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
